From 51e8a2509f4bbabb481962d4467737790b938ca7 Mon Sep 17 00:00:00 2001
From: cjuju <noctoir@gmail.com>
Date: Mon, 17 Aug 2026 00:58:05 +0200
Subject: [PATCH 1/5] pti_params: added hook module into build, startup, msg
 and DDS topics

---
 ROMFS/px4fmu_common/init.d/rc.fw_apps        | 5 +++++
 boards/px4/fmu-v5/default.px4board           | 1 +
 msg/CMakeLists.txt                           | 1 +
 src/modules/uxrce_dds_client/dds_topics.yaml | 3 +++
 4 files changed, 10 insertions(+)

diff --git a/ROMFS/px4fmu_common/init.d/rc.fw_apps b/ROMFS/px4fmu_common/init.d/rc.fw_apps
index 7597c989b3..3e03a66455 100644
--- a/ROMFS/px4fmu_common/init.d/rc.fw_apps
+++ b/ROMFS/px4fmu_common/init.d/rc.fw_apps
@@ -28,3 +28,8 @@ fw_autotune_attitude_control start
 # Start Land Detector.
 #
 land_detector start fixedwing
+
+#
+# Start PTI parameters module.
+#
+pti_params start
diff --git a/boards/px4/fmu-v5/default.px4board b/boards/px4/fmu-v5/default.px4board
index 9a36ff1fe7..e104bcedd6 100644
--- a/boards/px4/fmu-v5/default.px4board
+++ b/boards/px4/fmu-v5/default.px4board
@@ -73,6 +73,7 @@ CONFIG_MODULES_MC_HOVER_THRUST_ESTIMATOR=y
 CONFIG_MODULES_MC_POS_CONTROL=y
 CONFIG_MODULES_MC_RATE_CONTROL=y
 CONFIG_MODULES_NAVIGATOR=y
+CONFIG_MODULES_PTI_PARAMS=y
 CONFIG_MODULES_RC_UPDATE=y
 CONFIG_MODULES_SENSORS=y
 CONFIG_MODULES_SIMULATION_SIMULATOR_SIH=y
diff --git a/msg/CMakeLists.txt b/msg/CMakeLists.txt
index 7eda1cc316..ce7dad2842 100644
--- a/msg/CMakeLists.txt
+++ b/msg/CMakeLists.txt
@@ -167,6 +167,7 @@ set(msg_files
 	PowerButtonState.msg
 	PowerMonitor.msg
 	PpsCapture.msg
+	PtiParams.msg
 	PurePursuitStatus.msg
 	PwmInput.msg
 	Px4ioStatus.msg
diff --git a/src/modules/uxrce_dds_client/dds_topics.yaml b/src/modules/uxrce_dds_client/dds_topics.yaml
index 7cc39d199c..c2884f0c89 100644
--- a/src/modules/uxrce_dds_client/dds_topics.yaml
+++ b/src/modules/uxrce_dds_client/dds_topics.yaml
@@ -108,6 +108,9 @@ publications:
     type: px4_msgs::msg::GimbalDeviceAttitudeStatus
     rate_limit: 20.
 
+  - topic: /fmu/out/pti_params
+    type: px4_msgs::msg::PtiParams
+
 # Create uORB::Publication
 subscriptions:
   - topic: /fmu/in/register_ext_component_request
-- 
2.55.0

